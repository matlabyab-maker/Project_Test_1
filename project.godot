[application]
config/name="کوهستان برفی ۱۹۴۲ - Demo 20MB"
run/main_scene="res://Main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
throttle_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
throttle_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
turn_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
turn_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
pitch_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
pitch_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
